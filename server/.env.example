# Quantum Coffee only. DO NOT reuse Tap & Wrap credentials or project IDs.
# LOCAL DEVELOPMENT: use development, keep secrets in server/.env (Git-ignored).
# PRODUCTION: set actual values in Render -> Environment, never in GitHub.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Production requires PUBLIC_SITE_ORIGIN=https://your-real-domain.example
PUBLIC_SITE_ORIGIN=

# Separate Quantum Coffee cluster/project, user, and production database.
MONGODB_URI=
MONGODB_DB_NAME=quantumcoffee_production

# Keep disabled until email verification and password recovery exist.
REGISTRATION_ENABLED=false

# Local, one-time operation only; DO NOT set on Render.
ALLOW_ADMIN_BOOTSTRAP=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Future transactional email provider (integration still to be built).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_REPLY_TO=

# Phase 3B: fill with a new Quantum Coffee R2 bucket and credentials.
# R2_PUBLIC_BASE_URL must be HTTPS and include no bucket suffix unless that is how
# your public custom domain is configured. Public bucket must be dedicated to Quantum Coffee.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=

# Reserved for upcoming marketing tracking. Not yet wired.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
